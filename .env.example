# Reference only: the application does not automatically load .env files.
# run.py sets JWT_SECRET, DATABASE_URL, STORAGE_DIR and the MinerU values below for you.
# Use this list only to override them in the shell before starting run.py.
DATABASE_URL=sqlite:///./var/docintel.db
STORAGE_DIR=./var/originals

# LLM: gateway (any OpenAI-compatible server), local (Ollama), anthropic or baseline.
# Gateway values normally live in backend/app/gateway_settings.py (git-ignored).
# GATEWAY_URL=https://api.openai.com
# GATEWAY_TOKEN=
# GATEWAY_MODEL=gpt-4o-mini
# GATEWAY_TIMEOUT_SECONDS=280
# LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_URL=http://127.0.0.1:11434
# LOCAL_LLM_NUM_CTX=8192
# anthropic also needs ALLOW_CLOUD_EXTRACTION=true and ANTHROPIC_API_KEY.
# baseline is ONLY the explicitly selected offline comparison mode.

# Guardrail and long documents
# GUARDRAIL_RELEVANCE=enforce            # enforce | flag | off
# SEGMENT_MIN_PAGES=8
# BATCH_MAX_INVOICES=6                   # 12 invoices took 316 s to extract, over the 280 s gateway limit
# BATCH_MAX_CHARS=24000
# EXTRACTION_CONCURRENCY=3
# EXTRACTION_CACHE=on
MONEY_DECIMAL_STYLE=dot

# Semantic search: run.py uses embedded Qdrant through QDRANT_PATH (a folder, no server).
# For a Qdrant server, start the API without QDRANT_PATH and set QDRANT_URL.
# QDRANT_URL=http://localhost:6333
# SEMANTIC_MIN_SCORE=0.60
# SEMANTIC_MAX_GAP=0.04

# Private parser/observation artifacts default to STORAGE_DIR/.artifacts.
# ARTIFACTS_DIR=./var/artifacts
# MinerU 4.0.12: scripts/setup_mineru.ps1 provisions the Basic/ONNX bundle.
# scripts/start_pipeline_worker.ps1 defaults to this project-local directory.
MINERU_HOME=./var/mineru
MINERU_TIER=basic
MINERU_MODEL_SOURCE=local
MINERU_MODEL_BASE_DIR=./var/mineru/models
MINERU_MODEL_SMALL_BACKEND=onnx
# Standard/advanced profiles additionally require an explicitly local VLM engine.
# MINERU_MODEL_VLM_ENGINE=llama-cpp
# Optional overrides: OCR_MODEL_DIR, FASTEMBED_CACHE_PATH, HF_HOME.
